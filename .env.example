HOST=0.0.0.0
PORT=8016
BASE_URL=http://localhost:8016
ENV=development

# Optional inbound static bearer auth for /mcp
API_KEY=

# Optional Google OAuth for MCP caller auth
# Authorized redirect URI: {BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Redis-backed FastMCP OAuth persistence. Required outside development, or every redeploy forces users to reconnect.
REDIS_URL=
JWT_SIGNING_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
OAUTH_STORAGE_PREFIX=chainlink-feeds-mcp

FASTMCP_STATELESS_HTTP=true

# Required for Infura-backed feeds in feeds.json unless using RPC_URL_<CHAIN> overrides
INFURA_API_KEY=

# Optional per-chain RPC overrides
# RPC_URL_ETHEREUM=
# RPC_URL_BASE=

# Central observability — Axiom (https://axiom.co)
# Without AXIOM_TOKEN, audit events still go to stderr (Railway logs).
SERVICE_NAME=chainlink-feeds-mcp
AXIOM_TOKEN=
AXIOM_DATASET_AUDIT=mcp-audit
AXIOM_DATASET_LOGS=mcp-logs
